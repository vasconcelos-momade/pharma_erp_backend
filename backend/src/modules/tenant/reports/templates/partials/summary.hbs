<section class="section">
  <div class="section-heading">
    <h2 class="section-title">{{title}}</h2>
  </div>
  <table class="totals-table">
    <tbody>
      {{#each items}}
        <tr>
          <th>{{label}}</th>
          <td>{{value}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>
