<section class="section institutional-info">
  <div class="institutional-head">
    <img class="report-logo" src="{{logoSrc}}" alt="" />
    <div class="institutional-copy">
      <div class="report-brand">PHARMA ERP</div>
      <h1 class="report-title">{{titleText}}</h1>
      <p class="report-subtitle">{{subtitle}}</p>
    </div>
  </div>
  <dl class="report-meta">
    <div><dt>Farmacia:</dt><dd>{{institution.pharmacyName}}</dd></div>
    <div><dt>Filial:</dt><dd>{{institution.branchName}}</dd></div>
    <div><dt>Endereco:</dt><dd>{{institution.address}}</dd></div>
    <div><dt>NUIT:</dt><dd>{{institution.nuit}}</dd></div>
    <div><dt>Contactos:</dt><dd>{{institution.contacts}}</dd></div>
    <div><dt>Data:</dt><dd>{{generatedDate}}</dd></div>
    <div><dt>Hora:</dt><dd>{{generatedTime}}</dd></div>
    <div><dt>Utilizador:</dt><dd>{{generatedBy}}</dd></div>
  </dl>
</section>
