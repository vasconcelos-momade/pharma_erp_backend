generator client {
  provider = "prisma-client-js"
  output   = "./generated/tenant"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_TENANT")
}

model User {
  id                      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  name                    String
  email                   String?                  @unique
  role                    TenantUserRole           @default(GERENTE)
  active                  Boolean                  @default(true)
  centralUserId           BigInt?                  @db.UnsignedBigInt
  version                 Int                      @default(0)
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  caixaMovimentos         CaixaMovimento[]
  estoqueMovimentos       EstoqueMovimento[]
  faturas                 Fatura[]
  proformaInvoices                ProformaInvoice[]
  proformaInvoicesAprovadas       ProformaInvoice[]                @relation("ProformaInvoiceAprovador")
  dispensacoes            Dispensacao[]
  livroPsicotropicos      LivroPsicotropico[]
  livroReceitas           LivroReceita[]
  auditLogs               AuditLog[]
  userPermissions         UserPermission[]
  faturaAnulacoes         FaturaAnulacao[]
  faturasCanceladas       Fatura[]                 @relation("CancelledBy")
  sessoesFechadas         CaixaSessao[]            @relation("FechadoPor")
  paymentRefunds          PaymentRefund[]
  businessEvents          BusinessEvent[]
  caixaSessoes            CaixaSessao[]
  stockReversals          StockReversal[]
  contasReceber           ContaReceber[]
  contasReceberPagamentos ContaReceberPagamento[]
  contasPagar             ContaPagar[]
  authorizedFaturas       Fatura[]                 @relation("AuthorizedBy")
  authorizedContasReceber ContaReceber[]           @relation("AuthorizedBy")
  financialMovements      FinancialMovement[]
  faturaItemCancelamentos FaturaItemCancelamento[]
  validacoesDispensacao   Dispensacao[]            @relation("ValidadoPor")
  incineracoesResponsavel Incineracao[]            @relation("ResponsavelIncineracao")
  incineracoesAprovadas   Incineracao[]            @relation("AprovadoPorIncineracao")
  movimentosSanitarios    LoteMovimentoSanitario[]
  inventariosIniciados    Inventario[]             @relation("InventarioCriador")
  inventariosReconciliados Inventario[]            @relation("InventarioReconciliador")
  @@index([centralUserId])
  @@map("users")
}

model Terminal {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo      String    @unique
  nome        String
  localizacao String?
  ativo       Boolean   @default(true)
  deletedAt   DateTime?
  caixa       Caixa?
  faturas     Fatura[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("terminais")
}

model Caixa {
  id                     BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  terminalId             BigInt                  @unique @db.UnsignedBigInt
  terminal               Terminal                @relation(fields: [terminalId], references: [id])
  saldoAtual             Decimal                 @default(0) @db.Decimal(10, 2)
  version                Int                     @default(0)
  deletedAt              DateTime?
  movimentacoes          CaixaMovimento[]
  pagamentos             Pagamento[]
  sessoes                CaixaSessao[]
  financialMovements     FinancialMovement[]
  contaReceberPagamentos ContaReceberPagamento[]
  cashBalance            CashBalance?
  createdAt              DateTime                @default(now())

  @@map("caixas")
}

model CaixaMovimento {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  caixaId        BigInt                   @db.UnsignedBigInt
  userId         BigInt                   @db.UnsignedBigInt
  faturaId       BigInt?                  @db.UnsignedBigInt
  tipo           TipoCaixaMovimento
  origem         OrigemCaixaMovimentacao?
  categoria      CategoriaDespesa?
  valor          Decimal                  @db.Decimal(10, 2)
  saldoAnterior  Decimal                  @db.Decimal(10, 2)
  saldoFinal     Decimal                  @db.Decimal(10, 2)
  idempotencyKey String?                  @unique
  descricao      String?                  @db.Text
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  caixa          Caixa                    @relation(fields: [caixaId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
  fatura         Fatura?                  @relation(fields: [faturaId], references: [id])

  @@index([caixaId, createdAt])
  @@index([tipo, createdAt])
  @@map("caixa_movimentos")
}

model Cliente {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  nome           String
  telefone       String?
  email          String?
  tipo           TipoCliente
  documento      String?
  dataNascimento DateTime?
  sexo           String?
  nuit           String?
  endereco       String?
  empresaId      BigInt?        @db.UnsignedBigInt
  empresa        Empresa?       @relation(fields: [empresaId], references: [id])
  limiteCredito  Decimal?       @db.Decimal(14, 2)
  saldoAtual     Decimal        @default(0) @db.Decimal(14, 2)
  temPrescricao  Boolean        @default(false)
  version        Int            @default(0)
  deletedAt      DateTime?
  faturas        Fatura[]
  proformaInvoices       ProformaInvoice[]
  contasReceber  ContaReceber[]
  receitas       Receita[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([empresaId])
  @@map("clientes")
}

model Empresa {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  nome           String             @unique
  nuit           String?            @db.VarChar(50)
  limiteCredito  Decimal?           @db.Decimal(10, 2)
  saldoUsado     Decimal            @default(0) @db.Decimal(10, 2)
  ativo          Boolean            @default(true)
  statusContrato StatusConvenio     @default(ATIVO)
  deletedAt      DateTime?
  clientes       Cliente[]
  contratos      ConvenioContrato[]
  createdAt      DateTime           @default(now())

  @@map("empresas")
}

model ConvenioContrato {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  empresaId BigInt   @db.UnsignedBigInt
  limite    Decimal? @db.Decimal(10, 2)
  desconto  Decimal? @db.Decimal(5, 2)

  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())

  @@map("convenio_contratos")
}

model Categoria {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  nome      String    @unique @db.VarChar(191)
  codigoFNM String?   @unique @db.VarChar(64)
  descricao String?   @db.Text
  ativo     Boolean   @default(true)
  version   Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  produtos  Produto[]

  @@index([ativo])
  @@index([deletedAt])
  @@map("categorias")
}

model Produto {
  id                       BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  nomeComercial            String                  @db.VarChar(191)
  nomeGenerico             String?                 @db.Text
  dosagem                  String?                 @db.Text
  forma                    String?                 @db.Text
  apresentacao             String?                 @db.Text
  ativo                    Boolean                 @default(true)
  barcode                  String?                 @unique @db.VarChar(100)
  categoriaId              BigInt                  @db.UnsignedBigInt
  estoqueMinimo            Decimal                 @default(0) @db.Decimal(14, 2)
  taxRuleId                BigInt?                 @db.UnsignedBigInt
  version                  Int                     @default(0)
  deletedAt                DateTime?
  fornecedores             ProdutoFornecedor[]
  lotes                    Lote[]
  movimentos               EstoqueMovimento[]
  reservas                 EstoqueReserva[]
  historicoPrecos          HistoricoPreco[]
  alertasEstoque           AlertaEstoque[]
  stockValuation           StockValuation?
  stockBalance             StockBalance?
  dispensacoes             Dispensacao[]
  faturaItens              FaturaItem[]
  proformaInvoiceItems             ProformaInvoiceItem[]
  stockReversals           StockReversal[]
  regulacao                ProdutoRegulacao?
  classificacaoEventos     ProdutoClassificacaoEvento[]
  inventarioItens          InventarioItem[]
  purchaseSuggestion       PurchaseSuggestion?
  categoria                Categoria               @relation(fields: [categoriaId], references: [id])
  taxRule                  TaxRule?                @relation(fields: [taxRuleId], references: [id])
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([ativo])
  @@index([categoriaId])
  @@index([taxRuleId])
  @@map("produtos")
}

/// Política regulatória: campos legais essenciais + tipoDispensacao; demais flags derivadas em runtime.
model ProdutoRegulacao {
  produtoId                BigInt          @id @db.UnsignedBigInt
  tipoDispensacao          TipoDispensacao @default(VENDA_LIVRE)
  requiresPrescription     Boolean         @default(false)
  requiresPsychotropicBook Boolean         @default(false)
  policyVersion            Int             @default(1)
  produto                  Produto         @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  updatedAt                DateTime        @updatedAt

  @@index([tipoDispensacao])
  @@index([requiresPrescription])
  @@index([requiresPsychotropicBook])
  @@map("produto_regulacao")
}

/// Histórico append-only de classificação (auditoria / seed / reclassificação).
model ProdutoClassificacaoEvento {
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  produtoId  BigInt              @db.UnsignedBigInt
  source     ClassificacaoSource
  observacao String?             @db.Text
  snapshot   Json?
  createdAt  DateTime            @default(now())
  produto    Produto             @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, createdAt])
  @@map("produto_classificacao_eventos")
}

model Servico {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  nome               String             @unique @db.VarChar(255)
  tipoServicoClinico TipoServicoClinico
  preco              Decimal            @db.Decimal(14, 2)
  ativo              Boolean            @default(true)
  taxRuleId          BigInt?            @db.UnsignedBigInt
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  faturaItens        FaturaItem[]
  proformaInvoiceItems       ProformaInvoiceItem[]
  taxRule            TaxRule?           @relation(fields: [taxRuleId], references: [id])

  @@index([ativo])
  @@index([taxRuleId])
  @@map("servicos")
}

model Fornecedor {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  nome            String              @unique @db.VarChar(255)
  tipo            TipoFornecedor?
  nuit            String?             @db.VarChar(50)
  email           String?             @db.VarChar(255)
  telefone        String?             @db.VarChar(50)
  telefoneAlt     String?             @db.VarChar(50)
  endereco        String?             @db.Text
  cidade          String?             @db.VarChar(100)
  provincia       String?             @db.VarChar(100)
  pais            String?             @default("Mocambique") @db.VarChar(100)
  contatoNome     String?             @db.VarChar(255)
  observacoes     String?             @db.Text
  ativo           Boolean             @default(true)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  produtos        ProdutoFornecedor[]
  lotes           Lote[]
  contasPagar     ContaPagar[]
  historicoPrecos HistoricoPreco[]
  purchaseSuggestions PurchaseSuggestion[]
  @@map("fornecedores")
}

model ProdutoFornecedor {
  id                  BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  produtoId           BigInt     @db.UnsignedBigInt
  fornecedorId        BigInt     @db.UnsignedBigInt
  precoCompra         Decimal    @db.Decimal(10, 2)
  fornecedorPrincipal Boolean    @default(false)
  prazoEntregaDias    Int?
  codigoFornecedor    String?
  produto             Produto    @relation(fields: [produtoId], references: [id])
  fornecedor          Fornecedor @relation(fields: [fornecedorId], references: [id])

  @@unique([produtoId, fornecedorId])
  @@map("produtos_fornecedores")
}

/// Cache operacional de sugestões de compra (não representa uma compra real).
model PurchaseSuggestion {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  produtoId          BigInt               @unique @db.UnsignedBigInt
  supplierId         BigInt?              @db.UnsignedBigInt
  quantidadeAtual    Decimal              @db.Decimal(14, 2)
  estoqueMinimo      Decimal              @db.Decimal(14, 2)
  consumoMedioDiario Decimal              @db.Decimal(14, 4)
  quantidadeSugerida Decimal              @db.Decimal(14, 2)
  coberturaDias      Int                  @default(30)
  origem             OrigemSugestaoCompra @default(AUTOMATICA)
  observacao         String?              @db.Text
  generatedAt        DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  produto            Produto              @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedor         Fornecedor?          @relation(fields: [supplierId], references: [id])

  @@index([origem])
  @@index([supplierId])
  @@map("purchase_suggestions")
}

model Lote {
  id                   BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  produtoId            BigInt                   @db.UnsignedBigInt
  fornecedorId         BigInt?                  @db.UnsignedBigInt
  numeroLote           String                   @db.VarChar(100)
  dataValidade         DateTime
  dataFabricacao       DateTime?
  quantidadeInicial    Decimal                  @db.Decimal(10, 2)
  quantidadeQuarentena Decimal                  @default(0) @db.Decimal(10, 2)
  quantidadeIncinerada Decimal                  @default(0) @db.Decimal(10, 2)
  precoCompra          Decimal                  @db.Decimal(10, 2)
  precoVenda           Decimal?                 @db.Decimal(10, 2)
  ativo                Boolean                  @default(true)
  estadoSanitario      EstadoSanitarioLote      @default(VALIDO)
  disponibilidade      DisponibilidadeLote      @default(DISPONIVEL)
  version              Int                      @default(0)
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  produto              Produto                  @relation(fields: [produtoId], references: [id])
  fornecedor           Fornecedor?              @relation(fields: [fornecedorId], references: [id])
  movimentos           EstoqueMovimento[]
  reservas             EstoqueReserva[]
  dispensacoes         Dispensacao[]
  stockReversals       StockReversal[]
  movimentosSanitarios LoteMovimentoSanitario[]
  incineracaoItens     IncineracaoItem[]
  inventarioItens    InventarioItem[]
  stockBalance         LoteStockBalance?
  faturaItemLotes      FaturaItemLote[]

  @@unique([produtoId, numeroLote, dataValidade])
  @@index([produtoId])
  @@index([numeroLote])
  @@index([produtoId, ativo, estadoSanitario, disponibilidade, dataValidade]) // FEFO Otimizado Enterprise
  @@map("lotes")
}

model LoteMovimentoSanitario {
  id                  BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  loteId              BigInt                 @db.UnsignedBigInt
  tipo                TipoMovimentoSanitario
  quantidade          Decimal                @db.Decimal(10, 2)
  motivo              String                 @db.Text
  responsavelId       BigInt                 @db.UnsignedBigInt
  documentoReferencia String?                @db.VarChar(100)
  createdAt           DateTime               @default(now())

  lote        Lote @relation(fields: [loteId], references: [id])
  responsavel User @relation(fields: [responsavelId], references: [id])

  @@map("lote_movimentos_sanitarios")
}

model Incineracao {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  numeroAuto      String   @unique @db.VarChar(100)
  dataIncineracao DateTime
  responsavelId   BigInt   @db.UnsignedBigInt
  aprovadoPorId   BigInt?  @db.UnsignedBigInt
  entidadeDestino String?  @db.VarChar(255)
  observacoes     String?  @db.Text
  createdAt       DateTime @default(now())

  responsavel User              @relation("ResponsavelIncineracao", fields: [responsavelId], references: [id])
  aprovadoPor User?             @relation("AprovadoPorIncineracao", fields: [aprovadoPorId], references: [id])
  itens       IncineracaoItem[]

  @@map("incineracoes")
}

model IncineracaoItem {
  id            BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  incineracaoId BigInt  @db.UnsignedBigInt
  loteId        BigInt  @db.UnsignedBigInt
  quantidade    Decimal @db.Decimal(10, 2)
  motivo        String? @db.Text

  incineracao Incineracao @relation(fields: [incineracaoId], references: [id])
  lote        Lote        @relation(fields: [loteId], references: [id])

  @@map("incineracao_itens")
}

model EstoqueMovimento {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  produtoId       BigInt        @db.UnsignedBigInt
  loteId          BigInt?       @db.UnsignedBigInt
  userId          BigInt        @db.UnsignedBigInt
  tipo            TipoMovimento
  quantidade      Decimal       @db.Decimal(14, 2)
  estoqueAnterior Decimal       @db.Decimal(14, 2)
  estoqueFinal    Decimal       @db.Decimal(14, 2)
  origem          String?
  idempotencyKey  String?       @unique
  observacoes     String?       @db.Text
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  produto         Produto       @relation(fields: [produtoId], references: [id])
  lote            Lote?         @relation(fields: [loteId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([produtoId, createdAt])
  @@index([loteId, createdAt])
  @@index([tipo])
  @@map("estoque_movimentos")
}

model HistoricoPreco {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  produtoId     BigInt      @db.UnsignedBigInt
  fornecedorId  BigInt?     @db.UnsignedBigInt
  precoAnterior Decimal     @db.Decimal(10, 2)
  precoNovo     Decimal     @db.Decimal(10, 2)
  variacao      Decimal?    @db.Decimal(10, 2)
  data          DateTime    @default(now())
  produto       Produto     @relation(fields: [produtoId], references: [id])
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])

  @@index([produtoId])
  @@map("historico_precos")
}

model AlertaEstoque {
  id        BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  produtoId BigInt     @db.UnsignedBigInt
  tipo      TipoAlerta
  mensagem  String
  resolvido Boolean    @default(false)
  createdAt DateTime   @default(now())
  produto   Produto    @relation(fields: [produtoId], references: [id])

  @@map("alertas_estoque")
}

model Fatura {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  numero             String              @unique
  serie              String
  tipo               TipoDocumentoFiscal @default(FT)
  clienteId          BigInt              @db.UnsignedBigInt
  cliente            Cliente             @relation(fields: [clienteId], references: [id])
  terminalId         BigInt?             @db.UnsignedBigInt
  terminal           Terminal?           @relation(fields: [terminalId], references: [id])
  userId             BigInt              @db.UnsignedBigInt
  user               User                @relation(fields: [userId], references: [id])
  idempotencyKey     String?             @unique
  subtotal           Decimal             @db.Decimal(14, 2)
  desconto           Decimal             @default(0) @db.Decimal(14, 2)
  ivaTotal           Decimal             @db.Decimal(14, 2)
  total              Decimal             @db.Decimal(14, 2)
  valorRecebido      Decimal?            @db.Decimal(14, 2)
  troco              Decimal             @default(0) @db.Decimal(14, 2)
  tipoOperacao       TipoOperacaoFiscal  @default(TRIBUTADA)
  tipoPagamento      TipoPagamentoFatura @default(DINHEIRO)
  moeda              String              @default("MZN")
  estado             EstadoFatura        @default(EMITIDA)
  qrCode             String?
  deletedAt          DateTime?
  version            Int                 @default(0)
  authorizedById     BigInt?             @db.UnsignedBigInt
  authorizedBy       User?               @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  cancelledAt        DateTime?
  cancelledById      BigInt?             @db.UnsignedBigInt
  cancelledBy        User?               @relation("CancelledBy", fields: [cancelledById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              FaturaItem[]
  pagamentos         Pagamento[]
  anulacao           FaturaAnulacao?
  caixaMovimentos    CaixaMovimento[]
  stockReversals     StockReversal[]
  contasReceber      ContaReceber[]
  reservas           EstoqueReserva[]
  dispensacoes       Dispensacao[]
  financialMovements FinancialMovement[]

  @@index([clienteId, estado])
  @@index([tipoPagamento])
  @@index([createdAt])
  @@index([estado])
  @@map("faturas")
}

model FaturaItem {
  id                      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  faturaId                BigInt                   @db.UnsignedBigInt
  produtoId               BigInt?                  @db.UnsignedBigInt
  servicoId               BigInt?                  @db.UnsignedBigInt
  descricao               String
  quantidade              Decimal                  @db.Decimal(14, 2)
  precoUnit               Decimal                  @db.Decimal(14, 2)
  custoUnitario           Decimal                  @default(0) @db.Decimal(14, 2)
  lucroUnitario           Decimal?                 @db.Decimal(14, 2)
  // Campos de snapshot fiscal (IMUTÁVEIS após emissão da fatura)
  baseCalculo             Decimal                  @default(0) @db.Decimal(14, 2) // base = quantidade * precoUnit
  iva                     Decimal                  @db.Decimal(5, 2)
  valorIva                Decimal                  @default(0) @db.Decimal(14, 2)
  taxaAplicada            Decimal                  @default(0) @db.Decimal(5, 2)
  tipoRegraFiscalSnapshot TipoRegraFiscal?
  codigoRegraFiscal       String?                  @db.VarChar(50)
  moedaTaxa               String                   @default("MZN") @db.VarChar(10)
  motivoIsencao           String?                  @db.Text
  total                   Decimal                  @db.Decimal(14, 2)
  fatura                  Fatura                   @relation(fields: [faturaId], references: [id])
  produto                 Produto?                 @relation(fields: [produtoId], references: [id])
  servico                 Servico?                 @relation(fields: [servicoId], references: [id])
  dispensacao             Dispensacao?
  cancelamentos           FaturaItemCancelamento[]
  stockReversals          StockReversal[]
  lotesAlocacao           FaturaItemLote[]

  @@map("fatura_itens")
}

/// Rastreabilidade FEFO: um item de fatura pode consumir N lotes.
model FaturaItemLote {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  faturaItemId BigInt     @db.UnsignedBigInt
  loteId       BigInt     @db.UnsignedBigInt
  quantidade   Decimal    @db.Decimal(14, 2)
  ordemFefo    Int        @default(1)
  createdAt    DateTime   @default(now())
  faturaItem   FaturaItem @relation(fields: [faturaItemId], references: [id], onDelete: Cascade)
  lote         Lote       @relation(fields: [loteId], references: [id])

  @@unique([faturaItemId, loteId])
  @@index([faturaItemId])
  @@index([loteId])
  @@map("fatura_item_lotes")
}

/// Cache de stock por lote (projeção de EstoqueMovimento).
model LoteStockBalance {
  id                   BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  loteId               BigInt   @unique @db.UnsignedBigInt
  quantidadeTotal      Decimal  @default(0) @db.Decimal(14, 2)
  quantidadeDisponivel Decimal  @default(0) @db.Decimal(14, 2)
  version              Int      @default(0)
  lastUpdated          DateTime @updatedAt
  lote                 Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)

  @@map("lote_stock_balances")
}

model ProformaInvoice {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  numero            String        @unique
  clienteNome       String        @map("cliente")
  clienteId         BigInt?       @db.UnsignedBigInt
  nuit              String?       @db.VarChar(50)
  contacto          String?       @db.VarChar(50)
  clienteCadastrado Cliente?      @relation(fields: [clienteId], references: [id])
  userId            BigInt        @db.UnsignedBigInt
  user              User          @relation(fields: [userId], references: [id])
  subtotal          Decimal       @default(0) @db.Decimal(14, 2)
