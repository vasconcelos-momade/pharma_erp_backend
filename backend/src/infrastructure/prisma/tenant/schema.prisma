model FinancialSummary {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  periodo       String // DIARIO, MENSAL, TRIMESTRAL
  ano           Int
  mes           Int?
  dia           Int?
  totalVendas   Decimal  @db.Decimal(12, 2)
  totalCustos   Decimal  @db.Decimal(12, 2)
  totalDespesas Decimal  @db.Decimal(12, 2)
  lucroBruto    Decimal  @db.Decimal(12, 2)
  lucroLiquido  Decimal  @db.Decimal(12, 2)
  margemLucro   Decimal  @db.Decimal(5, 2)
  createdAt     DateTime @default(now())

  @@unique([periodo, ano, mes, dia], name: "periodo_ano_mes_dia")
  @@map("financial_summary")
}

model Receita {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  clienteId        BigInt        @db.UnsignedBigInt
  medicoNome       String?
  numeroReceita    String?
  unidadeSanitaria String?
  dataReceita      DateTime
  origemReceita    OrigemReceita @default(FISICA)
  observacoes      String?
  createdAt        DateTime      @default(now())

  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  livroReceitas LivroReceita[]
  dispensacoes  Dispensacao[]

  @@map("receitas")
}

model LivroReceita {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  dispensacaoId BigInt   @unique @db.UnsignedBigInt
  receitaId     BigInt   @db.UnsignedBigInt
  responsavelId BigInt   @db.UnsignedBigInt
  createdAt     DateTime @default(now())

  dispensacao Dispensacao @relation(fields: [dispensacaoId], references: [id])
  receita     Receita     @relation(fields: [receitaId], references: [id])
  responsavel User        @relation(fields: [responsavelId], references: [id])

  @@index([receitaId])
  @@index([createdAt])
  @@map("livro_receitas")
}

enum OrigemReceita {
  FISICA
  DIGITAL
  SISTEMA_INTERNO
}

enum TipoMovimentoReceita {
  ENTRADA
  SAIDA
  CANCELAMENTO
  AJUSTE
}

enum TipoPagamentoFatura {
  DINHEIRO
  CARTAO
  CREDITO_CONVENIO
  FIADO
  EMOLA
  MPESA
}

enum TipoRegraFiscal {
  IVA_NORMAL
  IVA_REDUZIDO
  IVA_ISENTO
  NAO_TRIBUTAVEL
}

model TaxRule {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  codigo          String          @unique @db.VarChar(50)
  nome            String          @db.VarChar(100)
  tipo            TipoRegraFiscal @default(IVA_NORMAL)
  taxa            Decimal         @default(0) @db.Decimal(5, 2) // 0 para isentos/nao tributaveis
  descricao       String?         @db.Text
  ativo           Boolean         @default(true)
  versao          Int             @default(1)
  dataInicio      DateTime?
  dataFim         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  produtos        Produto[]
  servicos        Servico[]

  @@index([ativo])
  @@index([tipo])
  @@map("regras_fiscais")
}
